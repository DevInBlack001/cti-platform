# .gitignore

# Local session handoff notes, never committed: progress state and next
# steps between working sessions, may reference in-progress work not
# ready to share.
CLAUDE.md

# Planning material and source documents this repo was seeded from.
# Kept locally, never committed: raw feasibility/report drafts, PDFs, notes.
attachments/

# Rust (peer validation layer, once it exists)
target/
**/target/
Cargo.lock
!/Cargo.lock

# Python (classifier service, once it exists)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Node / TypeScript (OpenCTI fork, once it's vendored in)
node_modules/
dist/
build/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# Local logs and scratch output
*.log

# Defense in depth: never let a signing key or observation sink land in the
# repo, in case CTI_KEY_DIR or CTI_OBSERVATION_SINK is ever pointed inside it.
*.pem
*.ndjson

# Personal Claude Code settings, machine-specific paths
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.copilot/

# The local validation VM, converted from the VMware Fedora VM. Large binary
# disk image, never belongs in git history.
vm/
