# Copy this file to .env and fill in real values. .env itself is
# gitignored and must never be committed; everything below is a
# placeholder or a documented default, not a real secret.

###########################
# DEPENDENCIES            #
###########################

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=changeme
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=changeme
SMTP_HOSTNAME=localhost

# Elasticsearch's JVM heap size. Sized down from OpenCTI's own suggested
# 4G default for this project's resource-constrained development VM;
# raise it if running somewhere with more memory to spare.
ELASTIC_MEMORY_SIZE=1G

###########################
# OPENCTI                 #
###########################

# Pinned to match this project's own OpenCTI fork version (opencti/,
# see its version.json); update both together.
OPENCTI_VERSION=7.260914.0

OPENCTI_HOST=localhost
OPENCTI_PORT=8080
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_ADMIN_EMAIL=admin@example.org
OPENCTI_ADMIN_PASSWORD=changeme
# A valid UUIDv4. Generate one with `python3 -c "import uuid; print(uuid.uuid4())"`.
OPENCTI_ADMIN_TOKEN=ChangeMe_UUIDv4
OPENCTI_HEALTHCHECK_ACCESS_KEY=changeme
# A base64-encoded key OpenCTI uses to encrypt data at rest. Generate
# one with `openssl rand -base64 32`.
OPENCTI_ENCRYPTION_KEY=ChangeMeWithGeneratedBase64Key

# One worker process is enough for development and testing traffic.
# Raise this for a deployment handling real import/export/enrichment load.
WORKER_REPLICAS=1

# OpenCTI's Node process heap limit, in megabytes. Sized down from
# OpenCTI's own suggested 8096 (8GB) default for this project's
# resource-constrained development VM; raise it if running somewhere
# with more memory to spare.
OPENCTI_NODE_MEMORY_MB=2048

###########################
# OPENCTI CONNECTORS      #
###########################

# Each of these must be a valid UUIDv4, one per connector, and stay
# stable across restarts so OpenCTI recognizes each connector as the
# same one every time it reconnects. Generate each with
# `python3 -c "import uuid; print(uuid.uuid4())"`.
CONNECTOR_EXPORT_FILE_STIX_ID=
CONNECTOR_EXPORT_FILE_CSV_ID=
CONNECTOR_EXPORT_FILE_TXT_ID=
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_DOCUMENT_ID=
CONNECTOR_IMPORT_FILE_YARA_ID=
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=
CONNECTOR_ANALYSIS_ID=
CONNECTOR_OPENCTI_ID=
CONNECTOR_MITRE_ID=
